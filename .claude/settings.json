{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(pnpm test)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm prettier)",
      "Bash(pnpm build)",
      "Bash(pnpm build-storybook)",
      "Bash(pnpm contrast)",
      "Bash(pnpm preset)",
      "Bash(pnpm agents)",
      "Bash(pnpm vrt)",
      "Bash(pnpm generate:component)",
      "Bash(pnpm install)",
      "Bash(tsc:*)",
      "Bash(eslint:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)"
    ],
    "deny": [
      "Bash(pnpm npm-publish)",
      "Bash(npm publish:*)",
      "Bash(git add -A)",
      "Bash(git add --all)",
      "Bash(git add .)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/warn-ungated-files.sh"
          }
        ]
      }
    ]
  }
}
